{
  "name": "pylab-dsba",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LMS interactif pour pratiquer Python (MSc DSBA) : cours structurés, éditeur intégré et exécution Python dans le navigateur.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export-content": "node scripts/export-content.mjs",
    "verify-content": "node scripts/export-content.mjs && python3 scripts/verify_content.py",
    "check-content": "node --import ./scripts/raw-loader.mjs scripts/check-content.mjs",
    "check-examples": "python3 scripts/check_examples.py"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  }
}
